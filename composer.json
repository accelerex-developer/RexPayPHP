{
    "name": "pils36/rexpay",
    "description": "Helps make your Rexpay api calls with PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adebambo Adenuga",
            "email": "adenugaadebambo41@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pils36\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pils36\\Rexpay\\Tests\\": "tests/",
            "Pils36\\Rexpay\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:suite": "php tests/run_suite.php",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "friendsofphp/php-cs-fixer": "^3.50"
    }
}